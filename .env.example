# Copy this file to .env.local and fill in your keys, then restart `npm run dev`.

# Required. Free from https://www.themoviedb.org/settings/api
# Either the "API Key" (v3) or the "API Read Access Token" (v4) works.
TMDB_API_KEY=

# Optional, for IMDb ratings. Free (1,000 lookups/day) from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Default streaming region (two-letter country code). Users can still switch in the app.
DEFAULT_REGION=GB
