# Copy this file to .env.local and fill in your keys, then restart `npm run dev`.

# Required. Free from https://www.themoviedb.org/settings/api
# Either the "API Key" (v3) or the "API Read Access Token" (v4) works.
TMDB_API_KEY=

# Optional, for IMDb ratings. Free (1,000 lookups/day) from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Default streaming region (two-letter country code). Users can still switch in the app.
DEFAULT_REGION=GB

# Required. Postgres connection string for accounts and subscriptions (Neon recommended).
# On Vercel, adding the Neon integration sets this automatically. Locally, copy it from the
# Neon dashboard, or run `vercel env pull .env.local` once the project is linked.
DATABASE_URL=

# Only needed to run the weekly suggestions build by hand (see README). Any long random string.
# CRON_SECRET=

# Optional, for "Ask WatchNext" AI search ("shows like Luther", "action thrillers above 7 on IMDb").
# From https://platform.claude.com/settings/keys. Without it the search box works as before.
# ANTHROPIC_API_KEY=
# Optional: the Claude model to use (defaults to claude-opus-5-5).
# ANTHROPIC_MODEL=
